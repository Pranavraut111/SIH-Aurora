# Aurora — Environment Variables
# Copy this file to `.env` (repo root) and fill in real values.
# NEVER commit .env — it is ignored by .gitignore.

# ── Frontend: Firebase (optional) ─────────────────────────────
# If these are left empty, Firebase persistence/analytics is disabled
# and the app still runs.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Backend: Groq LLM explanation layer (optional) ────────────
# Used by simulator/simulator.py (put it in simulator/.env or export it).
# Never exposed to the browser.
GROQ_API_KEY=your-groq-api-key
