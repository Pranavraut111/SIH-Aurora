# ═══════════════════════════════════════════════════════════════
# Aurora — Environment Variables (single source: the ROOT .env)
#
#   cp .env.example .env      # then edit values
#
# NEVER commit .env — it is ignored by .gitignore.
# Python services load this file via simulator/config.py (python-dotenv);
# real environment variables always override .env values.
# The frontend (Vite) reads only VITE_* variables, at build/dev time.
# Every variable is optional; the defaults shown work for local dev.
# ═══════════════════════════════════════════════════════════════

# ── Python services: network ───────────────────────────────────
# Interface to bind. Keep 127.0.0.1 locally; containers set 0.0.0.0.
HOST=127.0.0.1
# Port of simulator/unified_backend.py (the single public backend).
API_PORT=8080
# Port of simulator/simulator.py (internal control API).
SIM_PORT=8001
# Where simulator.py POSTs telemetry (base URL, no path).
BACKEND_URL=http://localhost:8080
# Base URL of the internal simulator API (for backend→simulator calls).
SIMULATOR_URL=http://localhost:8001
# Comma-separated browser origins allowed by CORS and /ws/station.
# "*" is NOT allowed and is ignored if present.
ALLOWED_ORIGINS=http://localhost:5173

# ── Python services: data & simulation ─────────────────────────
# SQLite observations DB. Relative paths resolve against simulator/.
DB_PATH=data_store/antarctic_observations.db
# "reanalysis" (ERA5 weather → physics model) or "simulation" (random walk).
AURORA_MODE=reanalysis
# Replay speed multiplier (120 = 2 simulated hours per real minute).
AURORA_SPEED=120
# ERA5 replay start date (YYYY-MM-DD). Leave EMPTY to use the latest date
# available in simulator/weather_cache/ (no network needed at startup).
AURORA_DATE=
# Python log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# ── Python services: LLM explanation layer (optional) ──────────
# Server-side only; never exposed to the browser. If empty, explain
# endpoints return an honest "LLM unavailable" message.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── Frontend (Vite): backend addresses ─────────────────────────
# Absolute URLs for local dev, or relative paths behind a reverse proxy:
#   VITE_API_URL=/api            (or empty for same-origin; "/api" is appended if missing)
#   VITE_WS_URL=/ws/station      (ws:// or wss:// derived from the page URL)
#   VITE_SIM_URL=/sim            (legacy direct simulator calls)
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws/station
VITE_SIM_URL=http://localhost:8001

# ── Frontend (Vite): Firebase (DISABLED by default) ────────────
# Initialises only when VITE_ENABLE_FIREBASE is exactly "true" AND the
# values below are set. database.rules.json denies all reads/writes.
# Vite inlines any referenced VITE_* value into the bundle, so leave
# these empty while Firebase is disabled.
VITE_ENABLE_FIREBASE=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
