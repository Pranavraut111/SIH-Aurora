# Dependencies / virtualenvs
node_modules/
.venv/
venv/

# Build outputs
dist/
dist-ssr/
legacy/backend/target/

# Python caches / test artefacts
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Secrets — NEVER commit
.env
.env.*
!.env.example

# OS / editor junk
.DS_Store
._*
*.local
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.sw?

# Logs
logs
*.log
npm-debug.log*

# Local tool settings
.claude/settings.local.json

# NOTE: simulator/weather_cache/ and simulator/data_store/ are intentionally
# committed — they are required for the offline demo.

# Local code-review-graph index (machine-specific cache)
.code-review-graph/

# Local MCP config (contains absolute paths) — copy from .mcp.json.example
.mcp.json

# Open-Meteo FORECAST caches (rewritten every 3 h while running). ERA5 replay caches
# (simulator/weather_cache/<station>_<start>_<end>.json) stay tracked for the offline demo.
simulator/weather_cache/*_forecast.json
